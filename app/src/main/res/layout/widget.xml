<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <!-- السطر الأول: المدينة والصلاة القادمة على اليمين | الساعة والمتبقي على اليسار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- جهة اليمين -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wcity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="12sp"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="baseline">

                <TextView
                    android:id="@+id/wnext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D6B25E"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/wat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#F4F1E8"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- جهة اليسار -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:gravity="bottom">

                <TextClock
                    android:id="@+id/wclk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="h:mm"
                    android:timeZone="GMT+03:00"
                    android:textColor="#F4F1E8"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextClock
                    android:id="@+id/wap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:format12Hour="a"
                    android:format24Hour="a"
                    android:timeZone="GMT+03:00"
                    android:textColor="#D6B25E"
                    android:textSize="10sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wlab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="#A9C2B4"
                    android:textSize="10sp"/>

                <Chronometer
                    android:id="@+id/wcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:textColor="#D6B25E"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/wcdt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D6B25E"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- خط فاصل شفاف رفيع -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:background="#33D6B25E"/>

    <!-- السطر الثاني: أوقات الصلوات الخمس -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
