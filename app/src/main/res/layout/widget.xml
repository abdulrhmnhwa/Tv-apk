<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <!-- القسم العلوي: يمين = المدينة + الصلاة القادمة + وقت الأذان، يسار = الساعة + المتبقي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wcity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="13sp"
                android:ellipsize="end"
                android:singleLine="true" />
            <TextView
                android:id="@+id/wnext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6B25E"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/wat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:gravity="bottom">
                <TextClock
                    android:id="@+id/wclk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="h:mm"
                    android:timeZone="GMT+03:00"
                    android:textColor="#F4F1E8"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextClock
                    android:id="@+id/wap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="3dp"
                    android:format12Hour="a"
                    android:format24Hour="a"
                    android:timeZone="GMT+03:00"
                    android:textColor="#D6B25E"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/wlab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#A9C2B4"
                android:textSize="11sp" />
            <Chronometer
                android:id="@+id/wcd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layoutDirection="ltr"
                android:textColor="#D6B25E"
                android:textSize="25sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/wcdt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6B25E"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp"
        android:background="#33D6B25E" />

    <!-- القسم السفلي: أوقات الصلوات الخمس -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">
        <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="11sp" />
            <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F1E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="11sp" />
            <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F1E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="11sp" />
            <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F1E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="11sp" />
            <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F1E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="11sp" />
            <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F4F1E8" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
