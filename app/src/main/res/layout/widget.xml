<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/widget_bg">

    <!-- ================= الصف الأول: معلومات الصلاة والساعة (ارتفاع مرن) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- اليمين: المدينة والصلاة القادمة -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wcity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="11sp"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wnext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D6B25E"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/wat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#F4F1E8"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- اليسار: الساعة والعد التنازلي -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layoutDirection="ltr"
                android:gravity="bottom">

                <TextClock
                    android:id="@+id/wclk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="h:mm"
                    android:timeZone="GMT+03:00"
                    android:textColor="#F4F1E8"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextClock
                    android:id="@+id/wap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:format12Hour="a"
                    android:format24Hour="a"
                    android:timeZone="GMT+03:00"
                    android:textColor="#D6B25E"
                    android:textSize="9sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/wlab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:textColor="#A9C2B4"
                    android:textSize="9sp"/>

                <Chronometer
                    android:id="@+id/wcd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layoutDirection="ltr"
                    android:textColor="#D6B25E"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/wcdt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D6B25E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- خط فاصل خفيف بين الصفين -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:background="#33D6B25E"/>

    <!-- ================= الصف الثاني: أوقات الصلوات الخمس (5 أعمدة بالضبط) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">

        <!-- الصلاة 0 -->
        <LinearLayout
            android:id="@+id/c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="9sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/t0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- الصلاة 1 -->
        <LinearLayout
            android:id="@+id/c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="9sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/t1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- الصلاة 2 -->
        <LinearLayout
            android:id="@+id/c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="9sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/t2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- الصلاة 3 -->
        <LinearLayout
            android:id="@+id/c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="9sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/t3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- الصلاة 4 -->
        <LinearLayout
            android:id="@+id/c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/n4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="9sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/t4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
