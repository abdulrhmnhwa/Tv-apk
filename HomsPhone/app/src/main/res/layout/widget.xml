<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wroot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <!-- الصف العلوي: المدينة والطقس (يمين) + الساعة (يسار) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/wcity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#A9C2B4"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:gravity="bottom">
            <TextClock
                android:id="@+id/wclk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:format12Hour="h:mm"
                android:format24Hour="h:mm"
                android:timeZone="GMT+03:00"
                android:textColor="#F4F1E8"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextClock
                android:id="@+id/wap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:format12Hour="a"
                android:format24Hour="a"
                android:timeZone="GMT+03:00"
                android:textColor="#D6B25E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- الصف الأوسط: الصلاة القادمة ووقتها (يمين) + الوقت المتبقي (يسار) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/wnext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6B25E"
                android:textSize="30sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/wat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F4F1E8"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:id="@+id/wlab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9C2B4"
                android:textSize="12sp"
                android:singleLine="true" />
            <Chronometer
                android:id="@+id/wcd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layoutDirection="ltr"
                android:textColor="#D6B25E"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/wcdt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6B25E"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- شريط الذكر الذكي: سطر واحد (العنوان + النص)، والضغط عليه يفتح القسم المناسب -->
    <LinearLayout
        android:id="@+id/wtip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/tip_bg">
        <TextView
            android:id="@+id/wtl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D6B25E"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />
        <TextView
            android:id="@+id/wtx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="#F4F1E8"
            android:textSize="13sp"
            android:lineSpacingMultiplier="0.9"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- الصف السفلي: أوقات الصلوات الخمس -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5">
        <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="1dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="12sp" android:singleLine="true" />
            <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="#F4F1E8" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="1dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="12sp" android:singleLine="true" />
            <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="#F4F1E8" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="1dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="12sp" android:singleLine="true" />
            <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="#F4F1E8" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="1dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="12sp" android:singleLine="true" />
            <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="#F4F1E8" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="1dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9C2B4" android:textSize="12sp" android:singleLine="true" />
            <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:layout_marginTop="1dp" android:textColor="#F4F1E8" android:textSize="13sp" android:textStyle="bold" android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
